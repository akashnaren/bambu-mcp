{
  "name": "bambu-mcp",
  "version": "0.1.0",
  "description": "LAN MCP for one Bambu Lab printer (P1/P2/X1/A1/H2 dialects) with the Imagine Engineer design→print contract",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bambu-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "AGENTS.md",
    "DESIGN.md",
    "harness/**/*",
    "web/**/*",
    "cad/refs/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/index.js",
    "ui": "npm run build:web && npm run build && node dist/web.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "dev": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prove:cad": "tsx src/cad/prove.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "bambu",
    "bambu-lab",
    "p2s",
    "p1s",
    "lan",
    "mqtt",
    "ftps",
    "imagine"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akashnaren/bambu-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "bambu-js": "^3.0.1",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "sass": "^1.105.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
