# Copy to .env (never commit). Secrets stay in the environment only —
# not in tool arguments, chat, git, or committed MCP JSON.

# Printer LAN address (Settings → LAN Only)
BAMBU_IP=192.168.1.50

# 8-digit LAN access code shown on the printer
BAMBU_ACCESS_CODE=12345678

# Printer serial (device sticker / Settings)
BAMBU_SERIAL=01P00A000000000

# bambu-js typed dialect. P2S hardware speaks the P1S MQTT family.
BAMBU_MODEL=P1S

# Safe mode defaults to on when unset. Only status, temps, ams, and list_files
# run. Set to 0 only when you intentionally want upload, slice, or motion.
# print, pause, resume, and stop still require confirm: true after you agree.
BAMBU_SAFE_MODE=1

# Optional: OrcaSlicer / Bambu Studio CLI for the slice-hook
# SLICER_BIN=/home/you/Applications/BambuStudio.AppImage

# Set to 1 to run the MCP against an in-memory mock (no live printer)
# BAMBU_MOCK=0
